@model IEnumerable<VeterinaryClinic.Models.VetDoctor>

@{
    ViewData["Title"] = "Veterinarians";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-person-badge"></i> Veterinarians</h1>
        <p class="mb-0">All the vets</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="badge bg-primary">Total: @Model.Count()</span>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-primary">
                <i class="bi bi-house-door"></i> Home
            </a>
            <a href="/VetDoctors/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="bi bi-person"></i> Name</th>
                        <th><i class="bi bi-briefcase"></i> Specialty</th>
                        <th><i class="bi bi-heart"></i> Assigned Pets</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                            </td>
                            <td>
                                <span class="badge bg-info">@Html.DisplayFor(modelItem => item.Specialty)</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@(item.Pets?.Count ?? 0) pet(s)</span>
                            </td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a href="/VetDoctors/Details/@item.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a href="/VetDoctors/Edit/@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="/VetDoctors/Delete/@item.Id" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this veterinarian?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No Vets Yet</h4>
            <p>Add one to get started.</p>
            <a href="/VetDoctors/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New
            </a>
        </div>
    }
</div>
