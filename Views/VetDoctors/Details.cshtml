@model VeterinaryClinic.Models.VetDoctor

@{
    ViewData["Title"] = "Veterinarian Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-person-badge"></i> Veterinarian Details</h1>
        <p class="mb-0">Vet info</p>
    </div>
</div>

<div class="container">
    <div class="details-section">
        <h4><i class="bi bi-info-circle"></i> Info</h4>
        <dl class="row">
            <dt class="col-sm-3">
                <i class="bi bi-person"></i> Name
            </dt>
            <dd class="col-sm-9">
                <strong>@Html.DisplayFor(model => model.Name)</strong>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-briefcase"></i> Specialty
            </dt>
            <dd class="col-sm-9">
                <span class="badge bg-info fs-6">@Html.DisplayFor(model => model.Specialty)</span>
            </dd>
        </dl>
    </div>

    <div class="details-section">
        <h4><i class="bi bi-heart"></i> Assigned Pets (@(Model.Pets?.Count ?? 0))</h4>
        @if (Model.Pets != null && Model.Pets.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Microchip ID</th>
                            <th>Species</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pet in Model.Pets)
                        {
                            <tr>
                                <td><strong>@pet.Name</strong></td>
                                <td><code>@pet.MicrochipId</code></td>
                                <td><span class="badge bg-primary">@pet.Species</span></td>
                                <td>
                                    <a href="/Pets/Details/@pet.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No pets assigned yet.
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <a href="/VetDoctors/Edit/@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="/VetDoctors" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <a href="/" class="btn btn-outline-primary">
            <i class="bi bi-house-door"></i> Home
        </a>
    </div>
</div>
