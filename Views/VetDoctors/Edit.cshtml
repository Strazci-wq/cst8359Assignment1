@model VeterinaryClinic.Models.VetDoctor

@{
    ViewData["Title"] = "Edit Veterinarian";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square"></i> Edit Veterinarian</h1>
        <p class="mb-0">Change vet info</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form action="/VetDoctors/Edit/@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-person"></i> Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="Specialty" class="form-label">
                                <i class="bi bi-briefcase"></i> Specialty <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Specialty" class="form-control" />
                            <span asp-validation-for="Specialty" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save
                            </button>
                            <a href="/VetDoctors" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <a href="/" class="btn btn-outline-primary">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
