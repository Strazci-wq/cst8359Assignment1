@model VeterinaryClinic.Models.PetProfile

@{
    ViewData["Title"] = "Pet Profile Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-file-earmark-medical"></i> Pet Profile Details</h1>
        <p class="mb-0">Vet notes</p>
    </div>
</div>

<div class="container">
    <div class="details-section">
        <h4><i class="bi bi-heart"></i> Pet Info</h4>
        <dl class="row">
            <dt class="col-sm-3">
                <i class="bi bi-tag"></i> Pet Name
            </dt>
            <dd class="col-sm-9">
                <strong>@Html.DisplayFor(model => model.Pet!.Name)</strong>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-upc-scan"></i> Microchip ID
            </dt>
            <dd class="col-sm-9">
                <code>@Html.DisplayFor(model => model.Pet!.MicrochipId)</code>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-bug"></i> Species
            </dt>
            <dd class="col-sm-9">
                <span class="badge bg-primary">@Html.DisplayFor(model => model.Pet!.Species)</span>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-person-badge"></i> Veterinarian
            </dt>
            <dd class="col-sm-9">
                <a href="/VetDoctors/Details/@Model.Pet!.VetDoctorId" class="text-decoration-none">
                    <i class="bi bi-person"></i> @Html.DisplayFor(model => model.Pet!.VetDoctor!.Name)
                    <span class="badge bg-info">@Html.DisplayFor(model => model.Pet!.VetDoctor!.Specialty)</span>
                </a>
            </dd>
        </dl>
    </div>

    <div class="details-section">
        <h4><i class="bi bi-file-text"></i> Veterinary Notes</h4>
        @if (!string.IsNullOrEmpty(Model.VetNotes))
        {
            <div class="notes-display">
                @Html.DisplayFor(model => model.VetNotes)
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i> No notes yet.
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <a href="/PetProfiles/Edit/@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="/PetProfiles" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <a href="/" class="btn btn-outline-primary">
            <i class="bi bi-house-door"></i> Home
        </a>
    </div>
</div>
