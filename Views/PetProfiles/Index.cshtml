@model IEnumerable<VeterinaryClinic.Models.PetProfile>

@{
    ViewData["Title"] = "Pet Profiles";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-file-earmark-medical"></i> Pet Profiles</h1>
        <p class="mb-0">Vet notes for pets</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="badge bg-info">Total: @Model.Count()</span>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-primary">
                <i class="bi bi-house-door"></i> Home
            </a>
            <a href="/PetProfiles/Create" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Create (Form)
            </a>
            <a href="/PetProfiles/CreateFromFile" class="btn btn-success">
                <i class="bi bi-upload"></i> Create (Upload)
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="bi bi-heart"></i> Pet Name</th>
                        <th><i class="bi bi-upc-scan"></i> Microchip ID</th>
                        <th><i class="bi bi-bug"></i> Species</th>
                        <th><i class="bi bi-file-text"></i> Veterinary Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@Html.DisplayFor(modelItem => item.Pet!.Name)</strong>
                            </td>
                            <td>
                                <code>@Html.DisplayFor(modelItem => item.Pet!.MicrochipId)</code>
                            </td>
                            <td>
                                <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.Pet!.Species)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.VetNotes))
                                {
                                    if (item.VetNotes.Length > 100)
                                    {
                                        <span>@item.VetNotes.Substring(0, 100)...</span>
                                    }
                                    else
                                    {
                                        <span>@item.VetNotes</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No notes</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a href="/PetProfiles/Details/@item.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a href="/PetProfiles/Edit/@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="/PetProfiles/Delete/@item.Id" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this pet profile?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No Profiles Yet</h4>
            <p>Add one below.</p>
            <div>
                <a href="/PetProfiles/Create" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Create (Form)
                </a>
                <a href="/PetProfiles/CreateFromFile" class="btn btn-success">
                    <i class="bi bi-upload"></i> Create (Upload)
                </a>
            </div>
        </div>
    }
</div>
