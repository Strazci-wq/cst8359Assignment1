@model VeterinaryClinic.Models.PetProfile

@{
    ViewData["Title"] = "Delete Pet Profile";
}

<div class="page-header bg-danger">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle"></i> Delete Pet Profile</h1>
        <p class="mb-0">Delete this profile?</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger">
                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Warning!</h5>
                <p class="mb-0">All notes will be lost. Can't be undone.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Profile Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="bi bi-heart"></i> Pet Name
                        </dt>
                        <dd class="col-sm-8">
                            <strong>@Html.DisplayFor(model => model.Pet!.Name)</strong>
                        </dd>
                        <dt class="col-sm-4">
                            <i class="bi bi-upc-scan"></i> Microchip ID
                        </dt>
                        <dd class="col-sm-8">
                            <code>@Html.DisplayFor(model => model.Pet!.MicrochipId)</code>
                        </dd>
                        <dt class="col-sm-4">
                            <i class="bi bi-file-text"></i> Veterinary Notes
                        </dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.VetNotes))
                            {
                                <div class="notes-display" style="max-height: 200px; overflow-y: auto;">
                                    @Html.DisplayFor(model => model.VetNotes)
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No notes</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <form action="/PetProfiles/Delete/@Model.Id" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this pet profile? All notes will be permanently lost!');">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a href="/PetProfiles" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="bi bi-house-door"></i> Home
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
