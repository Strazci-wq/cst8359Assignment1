@model VeterinaryClinic.Models.PetProfile

@{
    ViewData["Title"] = "Create Pet Profile (Form Entry)";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-file-earmark-plus"></i> Add Pet Profile</h1>
        <p class="mb-0">Type in the vet notes</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-body">
                    <form action="/PetProfiles/Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="form-group mb-3">
                            <label for="PetId" class="form-label">
                                <i class="bi bi-heart"></i> Pet <span class="text-danger">*</span>
                            </label>
                            <select id="PetId" name="PetId" class="form-select" required>
                                <option value="">-- Pick a Pet --</option>
                                @if (ViewBag.PetId != null)
                                {
                                    @foreach (var item in (SelectList)ViewBag.PetId)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PetId" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label for="VetNotes" class="form-label">
                                <i class="bi bi-file-text"></i> Veterinary Notes
                            </label>
                            <textarea id="VetNotes" name="VetNotes" class="form-control" rows="12" placeholder="Type vet notes here..."></textarea>
                            <span asp-validation-for="VetNotes" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Add
                            </button>
                            <a href="/PetProfiles" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <a href="/" class="btn btn-outline-primary">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <a href="/PetProfiles/CreateFromFile" class="btn btn-outline-success">
                    <i class="bi bi-upload"></i> Or upload a file
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
