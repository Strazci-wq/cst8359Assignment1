@model IEnumerable<VeterinaryClinic.Models.Pet>

@{
    ViewData["Title"] = "Pets";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-heart"></i> Pets</h1>
        <p class="mb-0">All the pets</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="badge bg-success">Total: @Model.Count()</span>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-primary">
                <i class="bi bi-house-door"></i> Home
            </a>
            <a href="/Pets/Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="bi bi-tag"></i> Name</th>
                        <th><i class="bi bi-upc-scan"></i> Microchip ID</th>
                        <th><i class="bi bi-bug"></i> Species</th>
                        <th><i class="bi bi-person-badge"></i> Veterinarian</th>
                        <th><i class="bi bi-file-earmark-medical"></i> Profile</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                            </td>
                            <td>
                                <code>@Html.DisplayFor(modelItem => item.MicrochipId)</code>
                            </td>
                            <td>
                                <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.Species)</span>
                            </td>
                            <td>
                                <i class="bi bi-person"></i> @Html.DisplayFor(modelItem => item.VetDoctor!.Name)
                            </td>
                            <td>
                                @if (item.PetProfile != null)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Has Profile</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-x-circle"></i> No Profile</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a href="/Pets/Details/@item.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a href="/Pets/Edit/@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="/Pets/Delete/@item.Id" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this pet?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No Pets Yet</h4>
            <p>Add one to get started.</p>
            <a href="/Pets/Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New
            </a>
        </div>
    }
</div>
