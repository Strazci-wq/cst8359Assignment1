@model VeterinaryClinic.Models.Pet

@{
    ViewData["Title"] = "Delete Pet";
}

<div class="page-header bg-danger">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle"></i> Delete Pet</h1>
        <p class="mb-0">Delete this pet?</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger">
                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Warning!</h5>
                <p class="mb-0">This will also delete the pet's profile. Can't be undone.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Pet Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="bi bi-tag"></i> Name
                        </dt>
                        <dd class="col-sm-8">
                            <strong>@Html.DisplayFor(model => model.Name)</strong>
                        </dd>
                        <dt class="col-sm-4">
                            <i class="bi bi-upc-scan"></i> Microchip ID
                        </dt>
                        <dd class="col-sm-8">
                            <code>@Html.DisplayFor(model => model.MicrochipId)</code>
                        </dd>
                        <dt class="col-sm-4">
                            <i class="bi bi-bug"></i> Species
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Html.DisplayFor(model => model.Species)</span>
                        </dd>
                        <dt class="col-sm-4">
                            <i class="bi bi-person-badge"></i> Veterinarian
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.VetDoctor!.Name)
                        </dd>
                        @if (Model.PetProfile != null)
                        {
                            <dt class="col-sm-4">
                                <i class="bi bi-file-earmark-medical"></i> Profile
                            </dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-warning text-dark">Will be deleted</span>
                            </dd>
                        }
                    </dl>
                </div>
            </div>

            <form action="/Pets/Delete/@Model.Id" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this pet and its profile? This cannot be undone!');">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a href="/Pets" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="bi bi-house-door"></i> Home
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
