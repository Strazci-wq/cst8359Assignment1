@model VeterinaryClinic.Models.Pet

@{
    ViewData["Title"] = "Edit Pet";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square"></i> Edit Pet</h1>
        <p class="mb-0">Change pet info</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form action="/Pets/Edit/@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="MicrochipId" class="form-label">
                                <i class="bi bi-upc-scan"></i> Microchip ID <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MicrochipId" class="form-control" />
                            <span asp-validation-for="MicrochipId" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag"></i> Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Species" class="form-label">
                                <i class="bi bi-bug"></i> Species <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Species" class="form-control" />
                            <span asp-validation-for="Species" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="VetDoctorId" class="form-label">
                                <i class="bi bi-person-badge"></i> Assigned Veterinarian <span class="text-danger">*</span>
                            </label>
                            <select asp-for="VetDoctorId" class="form-select" asp-items="ViewBag.VetDoctorId">
                                <option value="">-- Select Veterinarian --</option>
                            </select>
                            <span asp-validation-for="VetDoctorId" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Save
                            </button>
                            <a href="/Pets" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <a href="/" class="btn btn-outline-primary">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
