@model VeterinaryClinic.Models.Pet

@{
    ViewData["Title"] = "Pet Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-heart"></i> Pet Details</h1>
        <p class="mb-0">Pet info</p>
    </div>
</div>

<div class="container">
    <div class="details-section">
        <h4><i class="bi bi-info-circle"></i> Info</h4>
        <dl class="row">
            <dt class="col-sm-3">
                <i class="bi bi-tag"></i> Name
            </dt>
            <dd class="col-sm-9">
                <strong>@Html.DisplayFor(model => model.Name)</strong>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-upc-scan"></i> Microchip ID
            </dt>
            <dd class="col-sm-9">
                <code>@Html.DisplayFor(model => model.MicrochipId)</code>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-bug"></i> Species
            </dt>
            <dd class="col-sm-9">
                <span class="badge bg-primary fs-6">@Html.DisplayFor(model => model.Species)</span>
            </dd>
            <dt class="col-sm-3">
                <i class="bi bi-person-badge"></i> Veterinarian
            </dt>
            <dd class="col-sm-9">
                <a href="/VetDoctors/Details/@Model.VetDoctorId" class="text-decoration-none">
                    <i class="bi bi-person"></i> @Html.DisplayFor(model => model.VetDoctor!.Name)
                    <span class="badge bg-info">@Html.DisplayFor(model => model.VetDoctor!.Specialty)</span>
                </a>
            </dd>
        </dl>
    </div>

    <div class="details-section">
        <h4><i class="bi bi-file-earmark-medical"></i> Pet Profile</h4>
        @if (Model.PetProfile != null)
        {
            <div class="notes-display">
                @Html.DisplayFor(model => model.PetProfile!.VetNotes)
            </div>
            <div class="mt-3">
                <a href="/PetProfiles/Details/@Model.PetProfile.Id" class="btn btn-info">
                    <i class="bi bi-eye"></i> View Profile
                </a>
                <a href="/PetProfiles/Edit/@Model.PetProfile.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No profile yet.
                <div class="mt-2">
                    <a href="/PetProfiles/Create?petId=@Model.Id" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Profile (Form)
                    </a>
                    <a href="/PetProfiles/CreateFromFile?petId=@Model.Id" class="btn btn-success">
                        <i class="bi bi-upload"></i> Add Profile (Upload)
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <a href="/Pets/Edit/@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="/Pets" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <a href="/" class="btn btn-outline-primary">
            <i class="bi bi-house-door"></i> Home
        </a>
    </div>
</div>
